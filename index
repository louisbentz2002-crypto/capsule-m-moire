<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Capsule Mémoire — Préserver l'essentiel</title>
  <template id="__bundler_thumbnail">
    <svg viewBox="0 0 120 80" xmlns="http://www.w3.org/2000/svg">
      <rect width="120" height="80" fill="#1A2B4A"/>
      <ellipse cx="60" cy="40" rx="32" ry="15" stroke="#C4A46B" stroke-width="1.2" fill="none"/>
      <ellipse cx="60" cy="40" rx="20" ry="9" stroke="#C4A46B" stroke-width="0.6" fill="none" stroke-dasharray="2 3" opacity="0.6"/>
      <circle cx="60" cy="40" r="2.5" fill="#C4A46B"/>
    </svg>
  </template>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">
  <script async src="https://js.stripe.com/v3/buy-button.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy:     #0D1829;
      --navy-mid: #1A2B4A;
      --beige:    #F0EAE0;
      --or:       #C4A46B;
      --or-l:     #D4B98A;
      --blanc:    #FAF8F5;
      --texte:    #2D3748;
      --muted:    #7A8BAA;
    }
    html { scroll-behavior: smooth; }
    body { background: var(--blanc); color: var(--texte); font-family: 'DM Sans', sans-serif; font-weight: 300; cursor: none; overflow-x: hidden; }
    a { text-decoration: none; color: inherit; }


    /* CURSOR */
    .cur-ring { position: fixed; width: 28px; height: 28px; border: 1.2px solid var(--or); border-radius: 50%; pointer-events: none; z-index: 9999; transform: translate(-50%,-50%); transition: width .25s, height .25s; }
    .cur-dot  { position: fixed; width: 5px; height: 5px; background: var(--or); border-radius: 50%; pointer-events: none; z-index: 9999; transform: translate(-50%,-50%); }

    /* LOADER */
    #loader { position: fixed; inset: 0; z-index: 9995; background: var(--navy); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28px; transition: opacity .7s, visibility .7s; }
    #loader.out { opacity: 0; visibility: hidden; pointer-events: none; }
    .ld-icon { animation: ldglow 1.8s ease-in-out infinite; }
    @keyframes ldglow { 0%,100%{filter:drop-shadow(0 0 8px rgba(196,164,107,.3))} 50%{filter:drop-shadow(0 0 24px rgba(196,164,107,.7))} }
    .ld-bar { width: 120px; height: 1px; background: rgba(196,164,107,.2); border-radius:1px; overflow:hidden; }
    .ld-bar-fill { height:100%; width:0; background:var(--or); animation: ldfill 1.6s ease forwards; }
    @keyframes ldfill { to { width:100%; } }
    .ld-txt { font-size:9px; letter-spacing:.32em; text-transform:uppercase; color:rgba(240,234,224,.3); }

    /* NAV */
    nav { position: fixed; top: 0; left: 0; right: 0; z-index: 900; height: 76px; padding: 0 60px; display: flex; align-items: center; justify-content: space-between; gap: 32px; transition: background .4s, box-shadow .4s; }
    nav.on { background: rgba(10,18,34,.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); box-shadow: 0 1px 0 rgba(196,164,107,.12); }
    .n-logo { display: flex; align-items: center; gap: 13px; flex-shrink: 0; }
    .n-logo-txt { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 15px; letter-spacing: .22em; text-transform: uppercase; color: var(--blanc); white-space: nowrap; }
    .n-logo-txt b { color: var(--or); font-weight: 500; letter-spacing: .28em; }
    .n-links { display: flex; align-items: center; gap: 36px; flex: 1; justify-content: center; }
    .n-links a { font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: rgba(240,234,224,.45); transition: color .2s; white-space: nowrap; }
    .n-links a:hover { color: var(--or); }
    .n-cta { flex-shrink: 0; }
    .btn-or { display: inline-block; background: var(--or); color: var(--navy); font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 10px; letter-spacing: .18em; text-transform: uppercase; padding: 12px 26px; border-radius: 2px; border: none; cursor: none; transition: background .2s, transform .15s; white-space: nowrap; }
    .btn-or:hover { background: var(--or-l); }
    .btn-ghost { display: inline-block; border: 1px solid rgba(196,164,107,.45); color: rgba(240,234,224,.65); font-family: 'DM Sans', sans-serif; font-weight: 300; font-size: 10px; letter-spacing: .2em; text-transform: uppercase; padding: 12px 28px; border-radius: 2px; cursor: none; transition: border-color .2s, color .2s; white-space: nowrap; }
    .btn-ghost:hover { border-color: var(--or); color: var(--or); }

    /* REVEAL */
    .rv { opacity: 0; transform: translateY(28px); transition: opacity .85s cubic-bezier(.16,1,.3,1), transform .85s cubic-bezier(.16,1,.3,1); }
    .rv.in { opacity: 1; transform: none; }
    .d1{transition-delay:.1s} .d2{transition-delay:.22s} .d3{transition-delay:.34s} .d4{transition-delay:.46s} .d5{transition-delay:.58s}

    /* HERO */
    #hero { min-height: 100vh; background: linear-gradient(160deg, var(--navy-mid) 0%, var(--navy) 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; position: relative; overflow: hidden; padding: 120px 40px 100px; gap: 0; }
    .h-glow1 { position:absolute; width:800px; height:800px; background:radial-gradient(circle,rgba(196,164,107,.1) 0%,transparent 62%); border-radius:50%; top:50%; left:50%; transform:translate(-50%,-50%); animation:hpulse 5s ease-in-out infinite; pointer-events:none; }
    .h-glow2 { position:absolute; width:400px; height:400px; background:radial-gradient(circle,rgba(196,164,107,.08) 0%,transparent 65%); border-radius:50%; top:50%; left:50%; transform:translate(-50%,-50%); animation:hpulse 3.5s ease-in-out infinite reverse; pointer-events:none; }
    @keyframes hpulse { 0%,100%{opacity:.5;transform:translate(-50%,-50%) scale(1)} 50%{opacity:1;transform:translate(-50%,-50%) scale(1.1)} }
    .h-eyebrow { font-size: 9px; letter-spacing: .38em; text-transform: uppercase; color: var(--or); margin-bottom: 24px; position:relative; z-index:1; }
    .h-title { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: clamp(60px, 9vw, 108px); line-height: 1; color: var(--blanc); position:relative; z-index:1; margin-bottom: 24px; }
    .h-title em { font-style: italic; color: var(--or); }
    .h-sub { font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 300; font-size: clamp(17px, 2vw, 24px); color: rgba(240,234,224,.52); max-width: 520px; line-height: 1.5; margin-bottom: 40px; position:relative; z-index:1; margin-bottom: 20px; }
    .h-tagline { font-size: 9px; letter-spacing: .38em; text-transform: uppercase; color: rgba(196,164,107,.45); position:relative; z-index:1; margin-bottom: 52px; }
    .h-btns { display:flex; gap:16px; align-items:center; position:relative; z-index:1; flex-wrap:wrap; justify-content:center; margin-bottom: 80px; }
    /* Hero reveals — no translateY since loader covers initial render */
    #hero .rv { transform: none; }
    #hero .rv.in { opacity: 1; }
    .h-scroll { position:absolute; bottom:32px; left:50%; transform:translateX(-50%); display:flex; flex-direction:column; align-items:center; gap:10px; font-size:8px; letter-spacing:.28em; text-transform:uppercase; color:rgba(240,234,224,.22); animation:scpulse 2s ease-in-out infinite; }
    @keyframes scpulse { 0%,100%{opacity:.22} 50%{opacity:.6} }

    /* PHILOSOPHIE */
    #philosophie { background: var(--beige); padding: 120px 56px; }
    #philosophie .inner { max-width:1200px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:96px; align-items:center; }
    .philo-body { font-size: 15px; color: var(--muted); line-height: 1.85; }
    .philo-body p + p { margin-top: 20px; }
    .philo-right { position:relative; padding-left: 52px; }
    .philo-right::before { content:''; position:absolute; left:0; top:0; bottom:0; width:1px; background:linear-gradient(to bottom,transparent,var(--or),transparent); }
    .philo-cit { font-family:'Cormorant Garamond',serif; font-style:italic; font-weight:300; font-size:clamp(26px,3vw,40px); color:var(--navy-mid); line-height:1.25; margin-bottom:24px; }
    .philo-cit span { color:var(--or); }
    .philo-sig { font-size:10px; letter-spacing:.22em; text-transform:uppercase; color:var(--muted); }

    /* PRESTATIONS */
    #prestations { background: var(--blanc); padding: 120px 56px; }
    #prestations .inner { max-width:1200px; margin:0 auto; }
    .hdr { margin-bottom:64px; }
    .sec-lbl { font-size:9px; letter-spacing:.35em; text-transform:uppercase; color:var(--or); margin-bottom:16px; }
    .sec-ttl { font-family:'Cormorant Garamond',serif; font-weight:300; font-size:clamp(34px,4vw,52px); color:var(--navy-mid); line-height:1.1; margin-bottom:0; }
    .sec-ttl em { font-style:italic; color:var(--or); font-weight:300; }
    .cards { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
    .card { background:var(--beige); border-radius:2px; padding:48px 40px 40px; position:relative; overflow:hidden; transition:transform .35s cubic-bezier(.16,1,.3,1), box-shadow .35s; border:1px solid rgba(196,164,107,.1); }
    .card::before { content:''; position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(to right,var(--or),var(--or-l)); transform:scaleX(0); transform-origin:left; transition:transform .45s cubic-bezier(.16,1,.3,1); }
    .card:hover::before { transform:scaleX(1); }
    .card:hover { transform:translateY(-6px); box-shadow:0 24px 56px rgba(13,24,41,.1); }
    .card-ico { margin-bottom:28px; }
    .card-ttl { font-family:'Cormorant Garamond',serif; font-weight:500; font-size:24px; color:var(--navy-mid); margin-bottom:12px; letter-spacing:.02em; }
    .card-desc { font-size:13px; color:var(--muted); line-height:1.8; margin-bottom:28px; }
    .badge { display:inline-block; border:1px solid rgba(196,164,107,.35); color:var(--or); font-size:9px; letter-spacing:.22em; text-transform:uppercase; padding:6px 13px; border-radius:1px; }

    /* PROCESSUS */
    #processus { background: var(--navy-mid); padding: 120px 56px; }
    #processus .inner { max-width:1200px; margin:0 auto; }
    #processus .sec-ttl { color:var(--blanc); }
    #processus .sec-lbl { color:var(--or); }
    .proc-track { position:relative; display:grid; grid-template-columns:repeat(4,1fr); gap:40px; margin-top:72px; }
    .proc-track::before { content:''; position:absolute; top:20px; left:calc(12.5%); right:calc(12.5%); height:1px; background:linear-gradient(to right,var(--or),rgba(196,164,107,.2)); }
    .proc-step { position:relative; padding-top:0; }
    .proc-num-wrap { display:flex; align-items:center; margin-bottom:28px; }
    .proc-num { width:42px; height:42px; border:1px solid var(--or); border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:'Cormorant Garamond',serif; font-weight:300; font-size:18px; color:var(--or); background:var(--navy-mid); position:relative; z-index:1; flex-shrink:0; }
    .proc-ttl { font-family:'Cormorant Garamond',serif; font-weight:500; font-size:18px; color:var(--blanc); margin-bottom:10px; }
    .proc-desc { font-size:13px; color:rgba(240,234,224,.5); line-height:1.75; }

    /* TÉMOIGNAGES */
    #temoignages { background: var(--beige); padding: 120px 56px; }
    #temoignages .inner { max-width:1200px; margin:0 auto; }
    .temo-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
    .temo-card { background:var(--blanc); border-radius:2px; padding:40px; border:1px solid rgba(196,164,107,.1); }
    .temo-mark { font-family:'Cormorant Garamond',serif; font-size:72px; color:var(--or); line-height:.6; display:block; margin-bottom:20px; opacity:.55; }
    .temo-txt { font-family:'Cormorant Garamond',serif; font-style:italic; font-weight:300; font-size:17px; color:var(--navy-mid); line-height:1.6; margin-bottom:24px; }
    .temo-sig { font-size:11px; letter-spacing:.12em; color:var(--muted); }
    .temo-sig b { color:var(--navy-mid); font-weight:400; }

    /* GARANTIES */
    #garanties { background: var(--blanc); padding: 80px 56px; }
    #garanties .inner { max-width:1200px; margin:0 auto; }
    .guar-grid { display:grid; grid-template-columns:repeat(4,1fr); border:1px solid rgba(196,164,107,.12); border-radius:3px; overflow:hidden; margin-top:56px; }
    .guar-item { padding:40px 36px; border-right:1px solid rgba(196,164,107,.12); }
    .guar-item:last-child { border-right:none; }
    .guar-ico { margin-bottom:20px; }
    .guar-ttl { font-family:'Cormorant Garamond',serif; font-weight:500; font-size:18px; color:var(--navy-mid); margin-bottom:10px; }
    .guar-desc { font-size:13px; color:var(--muted); line-height:1.7; }

    /* TARIFS */
    #tarifs { background: var(--beige); padding: 120px 56px; }
    #tarifs .inner { max-width:1100px; margin:0 auto; }
    .tarif-grid { display:grid; grid-template-columns:1fr 1fr; gap:28px; margin-top:64px; }
    .t-card { background:var(--blanc); border-radius:3px; padding:48px 40px; border:1px solid rgba(196,164,107,.12); position:relative; display:flex; flex-direction:column; }
    .t-card.feat { border:1.5px solid var(--or); box-shadow:0 16px 56px rgba(196,164,107,.12); }
    .t-badge { position:absolute; top:24px; right:24px; background:var(--or); color:var(--navy); font-size:8px; letter-spacing:.22em; text-transform:uppercase; padding:5px 11px; border-radius:1px; font-weight:500; }
    .t-name { font-family:'Cormorant Garamond',serif; font-weight:300; font-size:22px; color:var(--navy-mid); margin-bottom:8px; letter-spacing:.05em; }
    .t-price { font-family:'Cormorant Garamond',serif; font-weight:300; font-size:72px; color:var(--or); line-height:1; margin:20px 0 8px; letter-spacing:-.02em; }
    .t-price sup { font-size:28px; vertical-align:super; }
    .t-sub { font-size:12px; color:var(--muted); letter-spacing:.08em; margin-bottom:32px; }
    .t-list { display:flex; flex-direction:column; gap:12px; margin-bottom:36px; }
    .t-li { display:flex; gap:12px; align-items:flex-start; font-size:13px; color:var(--texte); line-height:1.5; }
    .t-li::before { content:'✦'; color:var(--or); font-size:9px; margin-top:3px; flex-shrink:0; }
    .t-note { font-size:10px; color:var(--muted); letter-spacing:.1em; text-align:center; margin-top:14px; }

    /* FAQ */
    #faq { background: var(--blanc); padding: 120px 56px; }
    #faq .inner { max-width:760px; margin:0 auto; }
    .faq-list { margin-top:56px; }
    .faq-item { border-bottom:1px solid rgba(196,164,107,.18); }
    .faq-q { display:flex; justify-content:space-between; align-items:center; padding:24px 0; cursor:none; gap:16px; }
    .faq-q-txt { font-family:'Cormorant Garamond',serif; font-weight:400; font-size:20px; color:var(--navy-mid); line-height:1.3; }
    .faq-icon { width:28px; height:28px; border:1px solid rgba(196,164,107,.3); border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:background .25s, border-color .25s; }
    .faq-item.open .faq-icon { background:var(--or); border-color:var(--or); }
    .faq-icon svg { transition:transform .3s; }
    .faq-item.open .faq-icon svg { transform:rotate(45deg); }
    .faq-a { max-height:0; overflow:hidden; transition:max-height .45s cubic-bezier(.16,1,.3,1), padding .35s; }
    .faq-item.open .faq-a { max-height:200px; }
    .faq-a-inner { padding:0 0 24px; font-size:14px; color:var(--muted); line-height:1.85; border-left:2px solid var(--or); padding-left:20px; }
    .faq-line { display:block; height:2px; background:linear-gradient(to right,var(--or),transparent); transform:scaleX(0); transform-origin:left; transition:transform .45s cubic-bezier(.16,1,.3,1); margin-bottom:0; }
    .faq-item.open .faq-line { transform:scaleX(1); }

    /* FOOTER */
    footer { background:#080F1B; padding:64px 56px; display:flex; flex-direction:column; align-items:center; gap:24px; text-align:center; position:relative; }
    footer::before { content:''; position:absolute; top:0; left:10%; right:10%; height:1px; background:linear-gradient(to right,transparent,var(--or),transparent); opacity:.35; }
    .ft-logo { font-family:'Cormorant Garamond',serif; font-weight:300; font-size:17px; letter-spacing:.32em; text-transform:uppercase; color:rgba(240,234,224,.35); }
    .ft-logo b { color:rgba(196,164,107,.55); }
    .ft-tag { font-family:'Cormorant Garamond',serif; font-style:italic; font-size:14px; color:rgba(196,164,107,.4); letter-spacing:.04em; }
    .ft-div { width:100%; max-width:400px; height:1px; background:rgba(196,164,107,.12); }
    .ft-email { font-size:13px; color:rgba(196,164,107,.6); }
    .ft-legal { font-size:9px; letter-spacing:.15em; text-transform:uppercase; color:rgba(240,234,224,.18); }

    /* RESPONSIVE */
    @media(max-width:960px){
      nav{padding:0 24px;} .n-links{display:none;} section{padding:80px 24px;}
      #philosophie{padding:80px 24px;} #philosophie .inner{grid-template-columns:1fr;gap:48px;}
      .cards,.temo-grid,.guar-grid,.tarif-grid,.proc-track{grid-template-columns:1fr;}
      .tarif-grid{gap:20px;}
      .t-card{padding:36px 28px;}
      .t-price{font-size:56px;}
      .proc-track::before{display:none;} .guar-item{border-right:none;border-bottom:1px solid rgba(196,164,107,.1);}
      #prestations,#processus,#temoignages,#garanties,#tarifs,#faq{padding:80px 24px;}
      footer{padding:48px 24px;}
    }
  </style>
</head>
<body>

<div class="cur-ring" id="cR"></div>
<div class="cur-dot"  id="cD"></div>

<div id="loader">
  <div class="ld-icon">
    <svg width="64" height="64" viewBox="0 0 36 36" fill="none">
      <circle cx="18" cy="18" r="16.5" stroke="#FAF8F5" stroke-width="1"/>
      <circle cx="18" cy="18" r="10" stroke="#C4A46B" stroke-width="0.6" stroke-dasharray="1.5 3"/>
      <circle cx="18" cy="18" r="2.5" fill="#C4A46B"/>
      <line x1="18" y1="14" x2="18" y2="12" stroke="#C4A46B" stroke-width="1" stroke-linecap="round"/>
      <line x1="18" y1="22" x2="18" y2="24" stroke="#C4A46B" stroke-width="1" stroke-linecap="round"/>
      <line x1="14" y1="18" x2="12" y2="18" stroke="#C4A46B" stroke-width="1" stroke-linecap="round"/>
      <line x1="22" y1="18" x2="24" y2="18" stroke="#C4A46B" stroke-width="1" stroke-linecap="round"/>
      <line x1="15.5" y1="15.5" x2="14.1" y2="14.1" stroke="#C4A46B" stroke-width="0.8" stroke-linecap="round"/>
      <line x1="20.5" y1="20.5" x2="21.9" y2="21.9" stroke="#C4A46B" stroke-width="0.8" stroke-linecap="round"/>
      <line x1="20.5" y1="15.5" x2="21.9" y2="14.1" stroke="#C4A46B" stroke-width="0.8" stroke-linecap="round"/>
      <line x1="15.5" y1="20.5" x2="14.1" y2="21.9" stroke="#C4A46B" stroke-width="0.8" stroke-linecap="round"/>
    </svg>
  </div>
  <div class="ld-bar"><div class="ld-bar-fill"></div></div>
  <div class="ld-txt">Capsule Mémoire</div>
</div>

<!-- NAV -->
<nav id="nav">
  <a href="#hero" class="n-logo">
    <!-- Logo : éclat doré dans cercle —  nouveau signe -->
    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="18" cy="18" r="16.5" stroke="#FAF8F5" stroke-width="1"/>
      <circle cx="18" cy="18" r="10" stroke="#C4A46B" stroke-width="0.6" stroke-dasharray="1.5 3"/>
      <circle cx="18" cy="18" r="2.5" fill="#C4A46B"/>
      <line x1="18" y1="14" x2="18" y2="12" stroke="#C4A46B" stroke-width="1" stroke-linecap="round"/>
      <line x1="18" y1="22" x2="18" y2="24" stroke="#C4A46B" stroke-width="1" stroke-linecap="round"/>
      <line x1="14" y1="18" x2="12" y2="18" stroke="#C4A46B" stroke-width="1" stroke-linecap="round"/>
      <line x1="22" y1="18" x2="24" y2="18" stroke="#C4A46B" stroke-width="1" stroke-linecap="round"/>
      <line x1="15.5" y1="15.5" x2="14.1" y2="14.1" stroke="#C4A46B" stroke-width="0.8" stroke-linecap="round"/>
      <line x1="20.5" y1="20.5" x2="21.9" y2="21.9" stroke="#C4A46B" stroke-width="0.8" stroke-linecap="round"/>
      <line x1="20.5" y1="15.5" x2="21.9" y2="14.1" stroke="#C4A46B" stroke-width="0.8" stroke-linecap="round"/>
      <line x1="15.5" y1="20.5" x2="14.1" y2="21.9" stroke="#C4A46B" stroke-width="0.8" stroke-linecap="round"/>
    </svg>
    <span class="n-logo-txt">CAPSULE <b>MÉMOIRE</b></span>
  </a>
  <div class="n-links">
    <a href="#prestations">Prestations</a>
    <a href="#processus">Processus</a>
    <a href="#tarifs">Tarifs</a>
    <a href="#faq">FAQ</a>
  </div>
  <div class="n-cta">
    <a href="#tarifs" class="btn-or mag">Commencer ma Capsule</a>
  </div>
</nav>

